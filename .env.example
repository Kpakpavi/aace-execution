# ============================================================================
# AACE — environment configuration
# Copy this file to `.env` (gitignored) and fill in real values.
# ============================================================================

# ---------- PostgreSQL (used by api, dashboard, and post-v0.1.0 features) ---

# PostgreSQL host. For local docker-compose, this stays as `postgres`.
POSTGRES_HOST=postgres

# PostgreSQL TCP port inside the container network (default 5432).
POSTGRES_PORT=5432

# Name of the AACE database.
POSTGRES_DB=aace

# PostgreSQL role/user.
POSTGRES_USER=postgres

# Password for POSTGRES_USER.
# CHANGE THIS for any deployed environment. Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-strong-password

# ---------- API auth -------------------------------------------------------

# Shared secret required in the X-API-Key header on all API endpoints
# except /health. Generate with: openssl rand -hex 32
AACE_API_KEY=replace-with-a-long-random-string

# ---------- Worker / AI-agent webhook (v0.1.0 essentials) -----------------

# The URL where your AI agent listens for scored opportunities.
# For local testing, use a free disposable URL from https://webhook.site
AGENT_WEBHOOK_URL=https://webhook.site/your-unique-id-here

# Shared secret used to HMAC-sign each webhook payload. The AI agent
# must verify this on its side. Generate with: openssl rand -hex 32
AGENT_WEBHOOK_SECRET=replace-with-a-long-random-string

# How often the worker runs one full fetch -> match -> score -> webhook tick.
# Default 30. Lower while tuning, higher to be polite to sources.
WORKER_INTERVAL_MINUTES=30

# Minimum absolute price spread (in USD) for an opportunity to ship.
# Production default $5. Lower for testing, raise to filter noise.
SCORER_MIN_ABS_SPREAD=5.0

# Minimum percentage spread (0.05 = 5%) for an opportunity to ship.
SCORER_MIN_PCT_SPREAD=0.05

# Multiplier applied to percent spread to compute the 0..1 score.
# 2.0 means a 50% spread caps the score at 1.0.
SCORER_PCT_MULTIPLIER=2.0

# Jaccard similarity cutoff (0..1) for two listing titles to be treated
# as the same product by the token-based matcher.
# 0.6 = balanced. Raise to 0.75 for stricter matching, lower to 0.4 to
# see more candidate matches during tuning.
MATCHER_SIMILARITY_THRESHOLD=0.6

# ---------- Observability (optional) --------------------------------------

# Sentry DSN. If set, both api and worker report errors to Sentry.
# Get a DSN at https://sentry.io (free tier is generous).
# Leave blank to disable.
SENTRY_DSN=

# Tag for Sentry events. Helps filter staging vs production.
SENTRY_ENVIRONMENT=production

# Fraction of transactions traced (0.0..1.0). Lower = cheaper.
SENTRY_TRACES_SAMPLE_RATE=0.1

# Worker log verbosity. INFO is fine for production; DEBUG for debugging.
LOG_LEVEL=INFO

# ---------- Resale-comps data sources (Sprint 2 — optional) ---------------

# Keepa API key. When set, the dashboard's "Best Profit Opportunities"
# panel surfaces real Amazon sold-history prices instead of the
# deterministic mock. Sign up at https://keepa.com/#!api (free tier
# allows ~150 lookups/day; ~€19/mo allows ~1.5M/month).
# Leave blank to keep the mock client (recommended for local dev).
KEEPA_API_KEY=

# SerpAPI key (Google Shopping snapshots for non-Amazon resale platforms).
# Sign up at https://serpapi.com. ~$50/mo for 5k searches.
# Leave blank to keep the mock client for non-Amazon platforms.
SERPAPI_KEY=

# ---------- Telegram notifier (optional, free) ---------------------------

# Bot token from @BotFather. Without this, the Telegram channel is
# silently disabled and the worker only delivers via the agent webhook.
TELEGRAM_BOT_TOKEN=

# Numeric chat ID where AACE should post. Find by:
#   1. Sending any message to your bot
#   2. Visiting https://api.telegram.org/bot<TOKEN>/getUpdates
#   3. Reading the "chat":{"id": ...} field from the JSON response
TELEGRAM_CHAT_ID=

# Skip notifications for opportunities below these floors. Both apply
# (AND, not OR). Defaults: $1.00 net, 3.0% ROI on the platform below.
TELEGRAM_MIN_NET_PROFIT=1.00
TELEGRAM_MIN_ROI_PERCENT=3.0

# Resale platform used for the fee + ROI math in the Telegram message.
# One of: eBay, Amazon, StockX, Mercari, FB Marketplace (National),
# FB Marketplace (Local). Default eBay.
TELEGRAM_DEFAULT_PLATFORM=eBay

# Default per-parcel shipping cost (USD) used in the same calc.
TELEGRAM_DEFAULT_SHIPPING=8.00

# ---------- NTFY.sh push notifier (optional, free, no signup) ------------

# Topic name to publish to. Pick something LONG and UNGUESSABLE — topics
# on the public ntfy.sh server are public; anyone who knows the name
# can subscribe AND publish. Example: aace-kpakpavi-deals-9f3k2q
NTFY_TOPIC=

# Override only if you self-host an ntfy instance. Default works fine.
NTFY_SERVER=https://ntfy.sh

# Skip notifications for opportunities below these floors. Both apply
# (AND, not OR). Defaults: $1.00 net, 3.0% ROI on the platform below.
NTFY_MIN_NET_PROFIT=1.00
NTFY_MIN_ROI_PERCENT=3.0

# Resale platform used for the fee + ROI math in the NTFY notification.
NTFY_DEFAULT_PLATFORM=eBay

# Default per-parcel shipping cost (USD).
NTFY_DEFAULT_SHIPPING=8.00
